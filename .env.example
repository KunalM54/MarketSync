Node_ENV=development/production

# ---- Server ----
PORT=3000

# ---- MongoDB ----
MONGO_URI=mongodb://127.0.0.1:27017/marketsync

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=7d

# ---- Razorpay (payments) ----
# Get keys from https://dashboard.razorpay.com (use test mode keys for development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- ImageKit (product image uploads) ----
# Get credentials from https://imagekit.io/dashboard -> Developer options
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-imagekit-id>

# ---- Twilio (WhatsApp OTP delivery) ----
# Get credentials from https://console.twilio.com
# TWILIO_WHATSAPP_FROM is your Twilio WhatsApp number WITHOUT the "whatsapp:" prefix, e.g. +14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
