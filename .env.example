Node_ENV=development/production

# ---- Server ----
PORT=3000

# ---- MongoDB ----
MONGO_URI=mongodb://127.0.0.1:27017/commercex

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=7d

# ---- Razorpay (payments) ----
# Get keys from https://dashboard.razorpay.com (use test mode keys for development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- ImageKit (product image uploads) ----
# Get credentials from https://imagekit.io/dashboard -> Developer options
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-imagekit-id>
